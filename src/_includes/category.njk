{%- set categoryData = categories[category] -%}
{%- include 'breadcrumb-cat.njk' -%}
{%- include 'category-intro.njk' -%}
<div class="grid grid-sidebar-right-268 gap-40 items-start">
<div>
<ul class="grid grid-col-3 gap-32 p-0 m-0">
{%- set categoryPosts = collections.blog -%}
{%- if categoryData -%}
{%- set categoryPosts = collections[categoryData.collection] -%}
{%- endif -%}
{%- for post in categoryPosts | reverse -%}
{%- include 'post-card.njk' -%}
{%- endfor -%}
</ul>
</div>
{% include 'sidebar.njk' %}
</div>
