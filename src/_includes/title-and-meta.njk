{%- set categorySeo = categories[category] -%}
{%- if tag == 'home-page' -%}
<title>11ty Theme - by Design 2 SEO</title>
<meta name="description" content="An Eleventy starter with Epic CSS utilities, shared category data, responsive blog listings and reusable templates for pages and posts.">
{%- elif tag == 'about-page' -%}
<title>About - 11ty Theme </title>
<meta name="description" content="Learn how this Eleventy starter organizes content, category data, shared templates and responsive layouts, with checks for adapting the theme.">
{%- elif categorySeo.seo and page.url == categorySeo.url -%}
<title>{{ categorySeo.seo.title }}</title>
<meta name="description" content="{{ categorySeo.seo.description }}">
{%- else -%}
<title>{{ title }} - 11ty Theme</title>
<meta name="description" content="{{ description }}">
{%- endif -%}
